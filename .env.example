MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=htn_speech_therapist
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ELEVENLABS_API_KEY=
# Optional overrides:
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Reasoning tokens. 0 keeps the coaching turn snappy; raise for more care.
# GEMINI_THINKING_BUDGET=0
# Flash capacity is spiky: transient 503s are retried in place before the
# fallback model is used. Quota (429) skips the wait - it is per-model.
# GEMINI_RETRY_ATTEMPTS=3
# GEMINI_RETRY_INITIAL_DELAY=0.5
# GEMINI_RETRY_MAX_DELAY=4.0
# GEMINI_TIMEOUT_S=30.0

# Longest practice clip accepted, in seconds.
# MAX_AUDIO_SECONDS=120

# Practice clips are stored in S3; Mongo keeps only the object key.
# Leave S3_BUCKET empty to run without AWS - uploads are skipped and reviews
# save with audio=null, so local dev needs no credentials.
S3_BUCKET=
# S3_REGION=us-east-1
# S3_KEY_PREFIX=speech-attempts
# Playback URL lifetime, in seconds.
# S3_URL_EXPIRY_S=3600
# Omit both on EC2/ECS/Lambda - the instance role is picked up automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
